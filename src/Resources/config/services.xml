<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <!-- Einstellungen, Tarife, Artikeldaten -->
        <service id="Nova\Versandkosten\Service\Settings">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="Nova\Versandkosten\Service\TariffStore">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="Nova\Versandkosten\Service\ProductClassifier">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="Nova\Versandkosten\Service\CargoboardQuoteProvider">
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
            <argument type="service" id="cache.object"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="Nova\Versandkosten\Service\QuoteService">
            <argument type="service" id="Nova\Versandkosten\Service\TariffStore"/>
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
            <argument type="service" id="Nova\Versandkosten\Service\ProductClassifier"/>
            <argument type="service" id="Nova\Versandkosten\Service\CargoboardQuoteProvider"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="Nova\Versandkosten\Service\BeipackService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
            <argument type="service" id="Nova\Versandkosten\Service\QuoteService"/>
            <argument type="service" id="Nova\Versandkosten\Service\ProductClassifier"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="Nova\Versandkosten\Service\RequestOrderService">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="order_delivery.repository"/>
            <argument type="service" id="order_transaction.repository"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Order\RecalculationService"/>
            <argument type="service" id="Shopware\Core\Content\Mail\Service\MailService"/>
            <argument type="service" id="Shopware\Core\System\StateMachine\StateMachineRegistry"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="Nova\Versandkosten\Service\EnergySurchargeService">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
            <argument type="service" id="Shopware\Core\Framework\Notification\NotificationService"/>
            <argument type="service" id="Shopware\Core\Content\Mail\Service\MailService"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Nova\Versandkosten\Service\AttemptLimiter">
            <argument type="service" id="cache.object"/>
        </service>

        <!-- Eigene Touren (1.2.0): Entitäten, PLZ-Koordinaten, Termine, Benachrichtigung -->
        <service id="Nova\Versandkosten\Core\Tour\TourRouteDefinition">
            <tag name="shopware.entity.definition" entity="nova_vk_tour_route"/>
        </service>
        <service id="Nova\Versandkosten\Core\Tour\TourVariantDefinition">
            <tag name="shopware.entity.definition" entity="nova_vk_tour_variant"/>
        </service>
        <service id="Nova\Versandkosten\Core\Tour\TourDateDefinition">
            <tag name="shopware.entity.definition" entity="nova_vk_tour_date"/>
        </service>
        <service id="Nova\Versandkosten\Core\Tour\TourPriceProfileDefinition">
            <tag name="shopware.entity.definition" entity="nova_vk_tour_price_profile"/>
        </service>
        <service id="Nova\Versandkosten\Core\Tour\TourSubscriberDefinition">
            <tag name="shopware.entity.definition" entity="nova_vk_tour_subscriber"/>
        </service>

        <service id="Nova\Versandkosten\Service\Tour\PostcodeDirectory">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="Nova\Versandkosten\Service\Tour\TourRepository">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="Nova\Versandkosten\Service\Tour\TourService">
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourRepository"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\PostcodeDirectory"/>
            <argument type="service" id="Nova\Versandkosten\Service\ProductClassifier"/>
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="Nova\Versandkosten\Service\Tour\TourNotificationService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\Content\Mail\Service\MailService"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\PostcodeDirectory"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourRepository"/>
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
            <argument type="service" id="logger"/>
            <argument>%kernel.secret%</argument>
        </service>

        <service id="Nova\Versandkosten\Service\Tour\TourNotifyLimiter">
            <argument type="service" id="cache.object"/>
        </service>

        <service id="Nova\Versandkosten\ScheduledTask\TourCleanupTask">
            <tag name="shopware.scheduled.task"/>
        </service>
        <service id="Nova\Versandkosten\ScheduledTask\TourCleanupTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourNotificationService"/>
            <argument type="service" id="logger"/>
            <tag name="messenger.message_handler"/>
        </service>

        <!-- Geplante Aufgaben (täglich) -->
        <service id="Nova\Versandkosten\ScheduledTask\EnergyFetchTask">
            <tag name="shopware.scheduled.task"/>
        </service>
        <service id="Nova\Versandkosten\ScheduledTask\EnergyFetchTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Nova\Versandkosten\Service\EnergySurchargeService"/>
            <tag name="messenger.message_handler"/>
        </service>
        <service id="Nova\Versandkosten\ScheduledTask\RequestCancelTask">
            <tag name="shopware.scheduled.task"/>
        </service>
        <service id="Nova\Versandkosten\ScheduledTask\RequestCancelTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Nova\Versandkosten\Service\RequestOrderService"/>
            <argument type="service" id="logger"/>
            <tag name="messenger.message_handler"/>
        </service>

        <!-- Kasse: Preis setzen (nach Shopwares DeliveryProcessor -5000, vor Versand-Promotions -5100) -->
        <service id="Nova\Versandkosten\Checkout\ShippingCostProcessor">
            <argument type="service" id="Nova\Versandkosten\Service\QuoteService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\QuantityPriceCalculator"/>
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
            <argument type="service" id="Nova\Versandkosten\Service\BeipackService"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourService"/>
            <tag name="shopware.cart.processor" priority="-5050"/>
        </service>

        <service id="Nova\Versandkosten\Checkout\ShippingCartValidator">
            <tag name="shopware.cart.validator"/>
        </service>

        <service id="Nova\Versandkosten\Checkout\ShippingMethodRouteDecorator"
                 decorates="Shopware\Core\Checkout\Shipping\SalesChannel\ShippingMethodRoute"
                 decoration-priority="-100"
                 public="true">
            <argument type="service" id="Nova\Versandkosten\Checkout\ShippingMethodRouteDecorator.inner"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
            <argument type="service" id="Nova\Versandkosten\Service\BeipackService"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourService"/>
        </service>

        <!-- Versandkosten auf Anfrage: nur Zahlarten ohne sofortigen Geldeinzug -->
        <service id="Nova\Versandkosten\Checkout\CheckoutGatewayRouteDecorator"
                 decorates="Shopware\Core\Checkout\Gateway\SalesChannel\CheckoutGatewayRoute"
                 decoration-priority="-100"
                 public="true">
            <argument type="service" id="Nova\Versandkosten\Checkout\CheckoutGatewayRouteDecorator.inner"/>
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
        </service>

        <service id="Nova\Versandkosten\Checkout\OrderSubscriber">
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
            <argument type="service" id="Shopware\Core\Content\Mail\Service\MailService"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Nova\Versandkosten\Service\BeipackService"/>
            <argument type="service" id="Nova\Versandkosten\Service\RequestOrderService"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourRepository"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Nova\Versandkosten\Storefront\CheckoutPageSubscriber">
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
            <argument type="service" id="Nova\Versandkosten\Service\BeipackService"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <!-- Produktexport: {{ nova_versand_label(product, context) }} -->
        <service id="Nova\Versandkosten\Twig\ShippingLabelExtension">
            <argument type="service" id="Nova\Versandkosten\Service\ProductClassifier"/>
            <tag name="twig.extension"/>
        </service>

        <!-- Administration -->
        <service id="Nova\Versandkosten\Controller\AdminController" public="true">
            <argument type="service" id="Nova\Versandkosten\Service\TariffStore"/>
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Nova\Versandkosten\Service\EnergySurchargeService"/>
            <argument type="service" id="Nova\Versandkosten\Service\RequestOrderService"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourRepository"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\PostcodeDirectory"/>
        </service>

        <service id="Nova\Versandkosten\Controller\TourAdminController" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="nova_vk_tour_route.repository"/>
            <argument type="service" id="nova_vk_tour_variant.repository"/>
            <argument type="service" id="nova_vk_tour_date.repository"/>
            <argument type="service" id="nova_vk_tour_subscriber.repository"/>
            <argument type="service" id="nova_vk_tour_price_profile.repository"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourRepository"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\PostcodeDirectory"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourNotificationService"/>
            <argument type="service" id="Nova\Versandkosten\Service\Settings"/>
        </service>

        <!-- Storefront/Store-API: Tourtermin wählen, Tour-Benachrichtigung -->
        <service id="Nova\Versandkosten\Controller\TourController" public="true">
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
        <service id="Nova\Versandkosten\Controller\TourStoreApiController" public="true">
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
        </service>
        <service id="Nova\Versandkosten\Controller\TourNotificationController" public="true">
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourNotificationService"/>
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourNotifyLimiter"/>
            <argument type="service" id="Shopware\Storefront\Page\GenericPageLoader"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
        <service id="Nova\Versandkosten\Controller\TourNotificationStoreApiController" public="true">
            <argument type="service" id="Nova\Versandkosten\Service\Tour\TourNotificationService"/>
        </service>

        <!-- Storefront: Bestellung zum Beipacken wählen -->
        <service id="Nova\Versandkosten\Controller\BeipackController" public="true">
            <argument type="service" id="Nova\Versandkosten\Service\BeipackService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="Shopware\Core\System\SalesChannel\SalesChannel\ContextSwitchRoute"/>
            <argument type="service" id="Nova\Versandkosten\Service\AttemptLimiter"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>
