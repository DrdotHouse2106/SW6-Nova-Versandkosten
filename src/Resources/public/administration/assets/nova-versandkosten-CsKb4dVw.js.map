{% block nova_vk_tour_panel %}
<div class="nova-vk-tour-panel">
    <sw-tabs position-identifier="nova-vk-tour-panel-tabs" class="nova-vk-tour-panel__tabs">
        <sw-tabs-item v-for="key in subTabs" :key="key" :route="subRoute(key)">
            {{ $tc('nova-vk-tour.tabs.' + key) }}
        </sw-tabs-item>
    </sw-tabs>

    <mt-card v-if="sub === 'dates'" position-identifier="nova-vk-tour-dates" :title="$tc('nova-vk-tour.tabs.dates')" :is-loading="loading">
        <div v-if="acl.can('nova_vk_tour.editor')" class="nova-vk-tour__actions nova-vk-tour__actions--top">
            <mt-button variant="primary" size="small" @click="$router.push({ name: 'nova.vk.tour.date' })">{{ $tc('nova-vk-tour.dates.new') }}</mt-button>
        </div>
        <p class="nova-vk-tour__muted">{{ $tc('nova-vk-tour.dates.help') }}</p>
        <label class="nova-vk-tour__check">
            <input v-model="showPast" type="checkbox"> {{ $tc('nova-vk-tour.dates.showPast') }}
        </label>
        <table v-if="dates.length" class="nova-vk-tour__table">
            <thead>
                <tr>
                    <th>{{ $tc('nova-vk-tour.dates.date') }}</th>
                    <th>{{ $tc('nova-vk-tour.dates.tour') }}</th>
                    <th>{{ $tc('nova-vk-tour.dates.status') }}</th>
                    <th>{{ $tc('nova-vk-tour.dates.trailer') }}</th>
                    <th>{{ $tc('nova-vk-tour.dates.priceProfile') }}</th>
                    <th>{{ $tc('nova-vk-tour.dates.deadline') }}</th>
                    <th>{{ $tc('nova-vk-tour.dates.deliveries') }}</th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="d in dates" :key="d.id">
                    <td><router-link :to="{ name: 'nova.vk.tour.date', params: { id: d.id } }">{{ formatDate(d.tourDate) }}</router-link></td>
                    <td>{{ d.label || $tc('nova-vk-tour.dates.oneOff') }}<span v-if="d.waypoints.length" class="nova-vk-tour__muted"> ({{ $tc('nova-vk-tour.dates.ownWaypoints') }})</span></td>
                    <td>{{ statusLabel(d.status) }}<span v-if="d.variantName" class="nova-vk-tour__muted"> · {{ d.variantName }}</span></td>
                    <td>{{ d.trailer ? '✓' : '–' }}</td>
                    <td>{{ d.priceProfileName || $tc('nova-vk-tour.profiles.default') }}</td>
                    <td>{{ formatDate(d.orderDeadline) }}</td>
                    <td>{{ d.deliveries }}</td>
                </tr>
            </tbody>
        </table>
        <p v-else>{{ $tc('nova-vk-tour.dates.none') }}</p>
        <p v-if="overview.settings && overview.settings.postcodes === 0" class="nova-vk-tour__error">{{ $tc('nova-vk-tour.general.noPostcodes') }}</p>
    </mt-card>

    <mt-card v-if="sub === 'routes'" position-identifier="nova-vk-tour-routes" :title="$tc('nova-vk-tour.tabs.routes')" :is-loading="loading">
        <div v-if="acl.can('nova_vk_tour.editor')" class="nova-vk-tour__actions nova-vk-tour__actions--top">
            <mt-button variant="primary" size="small" @click="$router.push({ name: 'nova.vk.tour.route' })">{{ $tc('nova-vk-tour.routes.new') }}</mt-button>
        </div>
        <p class="nova-vk-tour__muted">{{ $tc('nova-vk-tour.routes.help') }}</p>
        <table v-if="overview.routes.length" class="nova-vk-tour__table">
            <thead>
                <tr>
                    <th>{{ $tc('nova-vk-tour.routes.name') }}</th>
                    <th>{{ $tc('nova-vk-tour.routes.startEnd') }}</th>
                    <th>{{ $tc('nova-vk-tour.routes.variants') }}</th>
                    <th>{{ $tc('nova-vk-tour.routes.active') }}</th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="r in overview.routes" :key="r.id">
                    <td><router-link :to="{ name: 'nova.vk.tour.route', params: { id: r.id } }">{{ r.name }}</router-link></td>
                    <td>{{ r.startLabel }} – {{ r.endLabel }}</td>
                    <td>{{ r.variants.map((v) => v.name).join(', ') }}</td>
                    <td>{{ r.active ? '✓' : '–' }}</td>
                </tr>
            </tbody>
        </table>
        <p v-else>{{ $tc('nova-vk-tour.routes.none') }}</p>
    </mt-card>

    <mt-card v-if="sub === 'profiles'" position-identifier="nova-vk-tour-profiles" :title="$tc('nova-vk-tour.tabs.profiles')" :is-loading="loading">
        <div v-if="acl.can('nova_vk_tour.editor')" class="nova-vk-tour__actions nova-vk-tour__actions--top">
            <mt-button variant="primary" size="small" @click="editProfile(null)">{{ $tc('nova-vk-tour.profiles.new') }}</mt-button>
        </div>
        <p class="nova-vk-tour__muted">{{ $tc('nova-vk-tour.profiles.help') }}</p>
        <table class="nova-vk-tour__table">
            <thead>
                <tr>
                    <th>{{ $tc('nova-vk-tour.profiles.name') }}</th>
                    <th>{{ $tc('nova-vk-tour.profiles.small') }}</th>
                    <th>{{ $tc('nova-vk-tour.profiles.freight') }}</th>
                    <th>{{ $tc('nova-vk-tour.profiles.used') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr v-if="overview.defaultProfile">
                    <td>{{ $tc('nova-vk-tour.profiles.default') }}<div class="nova-vk-tour__muted">{{ $tc('nova-vk-tour.profiles.defaultHelp') }}</div></td>
                    <td>{{ $tc('nova-vk-tour.profiles.smallText', 0, { price: overview.defaultProfile.smallPrice, km: overview.defaultProfile.smallMaxKm }) }}</td>
                    <td>{{ formatTiers(overview.defaultProfile.freightTiers) }}</td>
                    <td>{{ overview.dates.filter((d) => !d.priceProfileId).length }}</td>
                    <td></td>
                </tr>
                <tr v-for="p in overview.profiles" :key="p.id">
                    <td><strong>{{ p.name }}</strong></td>
                    <td>{{ $tc('nova-vk-tour.profiles.smallText', 0, { price: p.smallPrice, km: p.smallMaxKm }) }}</td>
                    <td>{{ formatTiers(p.freightTiers) }}</td>
                    <td>{{ overview.dates.filter((d) => d.priceProfileId === p.id).length }}</td>
                    <td class="nova-vk-tour__actions">
                        <mt-button v-if="acl.can('nova_vk_tour.editor')" variant="secondary" size="small" @click="editProfile(p)">{{ $tc('nova-vk-tour.profiles.edit') }}</mt-button>
                        <mt-button v-if="acl.can('nova_vk_tour.deleter')" variant="critical" size="small" @click="deleteProfile(p)">{{ $tc('nova-vk-tour.general.delete') }}</mt-button>
                    </td>
                </tr>
            </tbody>
        </table>
        <p v-if="!overview.profiles || !overview.profiles.length">{{ $tc('nova-vk-tour.profiles.none') }}</p>

        <div v-if="profile" class="nova-vk-tour__editor">
            <h3>{{ profile.id ? $tc('nova-vk-tour.profiles.edit') : $tc('nova-vk-tour.profiles.new') }}</h3>
            <div class="nova-vk-tour__grid">
                <label>
                    <span>{{ $tc('nova-vk-tour.profiles.name') }} *</span>
                    <input v-model="profile.name" class="nova-vk-tour__input" type="text" maxlength="255" :placeholder="$tc('nova-vk-tour.profiles.namePlaceholder')">
                    <span class="nova-vk-tour__muted">{{ $tc('nova-vk-tour.profiles.nameHelp') }}</span>
                </label>
                <label>
                    <span>{{ $tc('nova-vk-tour.profiles.smallPrice') }} *</span>
                    <input v-model="profile.smallPrice" class="nova-vk-tour__input nova-vk-tour__input--short" type="number" min="0" step="0.01">
                </label>
                <label>
                    <span>{{ $tc('nova-vk-tour.profiles.smallMaxKm') }} *</span>
                    <input v-model="profile.smallMaxKm" class="nova-vk-tour__input nova-vk-tour__input--short" type="number" min="0" step="0.1">
                </label>
                <label>
                    <span>{{ $tc('nova-vk-tour.profiles.freightTiers') }}</span>
                    <textarea v-model="profile.freightTiers" class="nova-vk-tour__input" rows="3" placeholder="30=190&#10;60=290"></textarea>
                    <span class="nova-vk-tour__muted">{{ $tc('nova-vk-tour.profiles.freightTiersHelp') }}</span>
                </label>
                <label>
                    <span>{{ $tc('nova-vk-tour.profiles.position') }}</span>
                    <input v-model="profile.position" class="nova-vk-tour__input nova-vk-tour__input--short" type="number" min="0" step="1">
                </label>
            </div>
            <div class="nova-vk-tour__actions">
                <mt-button variant="secondary" size="small" @click="profile = null">{{ $tc('nova-vk-tour.profiles.cancel') }}</mt-button>
                <mt-button variant="primary" size="small" :disabled="profileSaving" @click="saveProfile">{{ $tc('nova-vk-tour.general.save') }}</mt-button>
            </div>
        </div>
    </mt-card>

    <mt-card v-if="sub === 'deliveries'" position-identifier="nova-vk-tour-delivery-list" :title="$tc('nova-vk-tour.deliveries.title')" :is-loading="loading || deliveryListLoading">
        <p class="nova-vk-tour__muted">{{ $tc('nova-vk-tour.deliveries.help') }}</p>
        <template v-if="deliveryDates.length">
            <div class="nova-vk-tour__filters">
                <label>
                    <span>{{ $tc('nova-vk-tour.deliveries.date') }}</span>
                    <select v-model="deliveryDateId" class="nova-vk-tour__input">
                        <option v-for="d in deliveryDates" :key="d.id" :value="d.id">{{ dateOption(d) }}</option>
                    </select>
                </label>
                <mt-button v-if="deliveryDateId" variant="secondary" size="small" @click="$router.push({ name: 'nova.vk.tour.date', params: { id: deliveryDateId } })">{{ $tc('nova-vk-tour.deliveries.openDate') }}</mt-button>
            </div>
            <nova-vk-tour-delivery-table :deliveries="deliveryList" />
        </template>
        <p v-else>{{ $tc('nova-vk-tour.dates.none') }}</p>
    </mt-card>

    <mt-card v-if="sub === 'subscribers'" position-identifier="nova-vk-tour-subscribers" :title="$tc('nova-vk-tour.subscribers.title')" :is-loading="subscribersLoading">
        <p v-if="overview.settings && !overview.settings.notifyEnabled" class="nova-vk-tour__error">{{ $tc('nova-vk-tour.subscribers.disabled') }}</p>
        <div class="nova-vk-tour__filters">
            <label>
                <span>{{ $tc('nova-vk-tour.subscribers.route') }}</span>
                <select v-model="filter.routeId" class="nova-vk-tour__input">
                    <option value="">{{ $tc('nova-vk-tour.subscribers.allRoutes') }}</option>
                    <option v-for="r in overview.routes" :key="r.id" :value="r.id">{{ r.name }}</option>
                </select>
            </label>
            <label>
                <span>{{ $tc('nova-vk-tour.subscribers.radius') }}</span>
                <input v-model="filter.radius" class="nova-vk-tour__input nova-vk-tour__input--short" type="number" min="1" max="500" :disabled="!filter.routeId" placeholder="60">
            </label>
            <label>
                <span>{{ $tc('nova-vk-tour.subscribers.search') }}</span>
                <input v-model="filter.q" class="nova-vk-tour__input" type="text" @keydown.enter.prevent="loadSubscribers">
            </label>
            <label class="nova-vk-tour__check">
                <input v-model="filter.pending" type="checkbox"> {{ $tc('nova-vk-tour.subscribers.pending') }}
            </label>
            <mt-button variant="secondary" size="small" @click="loadSubscribers">{{ $tc('nova-vk-tour.subscribers.apply') }}</mt-button>
            <mt-button variant="secondary" size="small" @click="exportCsv">{{ $tc('nova-vk-tour.subscribers.csv') }}</mt-button>
        </div>
        <table v-if="subscribers.length" class="nova-vk-tour__table">
            <thead>
                <tr>
                    <th>{{ $tc('nova-vk-tour.subscribers.type') }}</th>
                    <th>{{ $tc('nova-vk-tour.subscribers.email') }}</th>
                    <th>{{ $tc('nova-vk-tour.subscribers.place') }}</th>
                    <th>{{ $tc('nova-vk-tour.subscribers.since') }}</th>
                    <th>{{ $tc('nova-vk-tour.subscribers.source') }}</th>
                    <th>{{ $tc('nova-vk-tour.subscribers.confirmed') }}</th>
                    <th v-if="filter.routeId">km</th>
                    <th>{{ $tc('nova-vk-tour.subscribers.sent') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr v-for="s in subscribers" :key="s.id">
                    <td>
                        <template v-if="s.type === 'customer'">
                            <router-link :to="{ name: 'sw.customer.detail', params: { id: s.customer_id } }">{{ $tc('nova-vk-tour.subscribers.customer') }} {{ s.customer_number }}</router-link>
                            <div class="nova-vk-tour__muted">{{ s.name }}</div>
                        </template>
                        <template v-else>{{ $tc('nova-vk-tour.subscribers.guest') }}</template>
                    </td>
                    <td>{{ s.email }}</td>
                    <td>{{ s.postcode }} {{ s.place }}</td>
                    <td>{{ formatDateTime(s.created_at) }}</td>
                    <td>{{ $tc('nova-vk-tour.subscribers.source_' + s.source) }}</td>
                    <td>{{ s.status === 'active' ? '✓' : $tc('nova-vk-tour.subscribers.notConfirmed') }}</td>
                    <td v-if="filter.routeId">{{ s.km }}</td>
                    <td>{{ s.notifications }}</td>
                    <td><mt-button v-if="acl.can('nova_vk_tour.deleter')" variant="critical" size="small" @click="deleteSubscriber(s)">{{ $tc('nova-vk-tour.general.delete') }}</mt-button></td>
                </tr>
            </tbody>
        </table>
        <p v-else>{{ $tc('nova-vk-tour.subscribers.none') }}</p>
    </mt-card>
</div>
{% endblock %}
