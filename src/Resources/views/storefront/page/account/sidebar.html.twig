{% sw_extends '@Storefront/storefront/page/account/sidebar.html.twig' %}

{% block page_account_sidebar_link_orders %}
    {{ parent() }}

    {% if config('NovaVersandkosten.config.tourNotifyEnabled') and context.customer and not context.customer.guest %}
        {% block nova_versandkosten_account_sidebar_tour %}
            <a href="{{ path('frontend.nova_versandkosten.tour_notify.account') }}"
               title="{{ 'novaVersandkosten.tourNotify.accountLink'|trans|striptags }}"
               class="list-group-item list-group-item-action account-aside-item{% if activeRoute is same as('frontend.nova_versandkosten.tour_notify.account') %} is-active{% endif %}"
               {% if activeRoute is same as('frontend.nova_versandkosten.tour_notify.account') %} aria-current="page"{% endif %}>
                {{ 'novaVersandkosten.tourNotify.accountLink'|trans|sw_sanitize }}
            </a>
        {% endblock %}
    {% endif %}
{% endblock %}
